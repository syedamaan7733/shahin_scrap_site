---
import "../styles/global.css";
import { SITE, NAV, CONTACTS, whatsappLink, telLink } from "../config/site";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  ogImage = "/images/logo/logo.png",
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const fullTitle = `${title} | ${SITE.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.href,
  telephone: SITE.phoneE164,
  email: SITE.email,
  foundingDate: String(SITE.foundedYear),
  image: ogImageURL.href,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Mahamaya Road",
    addressLocality: "Ambikapur",
    addressRegion: "Chhattisgarh",
    postalCode: "497001",
    addressCountry: "IN",
  },
  openingHours: "Mo-Su 08:00-22:00",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {
      SITE.googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={SITE.googleSiteVerification}
        />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Droid+Serif:ital@1&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="fixed top-0 inset-x-0 z-50">
      <!-- Top bar: logo + credentials -->
      <div class="bg-[#ded9d5]">
        <div
          class="mx-auto max-w-7xl px-4 sm:px-6 h-16 flex items-center justify-between gap-4"
        >
          <a href="/" class="flex items-center shrink-0">
            <img
              src="/images/logo/logo.png"
              alt={`${SITE.name} — Since 1985`}
              class="h-13 w-auto"
            />
          </a>
          <div class="flex items-center gap-2">
            <a
              href={whatsappLink()}
              target="_blank"
              rel="noopener"
              class="font-heading inline-flex items-center gap-2 rounded-sm bg-copper-aged px-3 sm:px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white hover:brightness-110 transition"
            >
              WhatsApp
            </a>
            <button
              id="nav-toggle"
              class="lg:hidden inline-flex items-center justify-center h-10 w-10 text-navy-deep"
              aria-label="Toggle menu"
              aria-expanded="false"
            >
              <svg
                class="nav-icon h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path class="nav-icon-top" d="M4 6h16"></path>
                <path class="nav-icon-mid" d="M4 12h16"></path>
                <path class="nav-icon-bot" d="M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Nav bar (desktop only) -->
      <div class="bg-ink hidden lg:block">
        <div
          class="mx-auto max-w-7xl px-4 sm:px-6 h-12 flex items-center gap-4"
        >
          <nav class="flex items-stretch gap-8 self-stretch">
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    "relative inline-flex items-center font-heading text-xs font-semibold uppercase tracking-wider transition-colors",
                    currentPath === item.href
                      ? "text-brass-light after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-brass-light"
                      : "text-white/90 hover:text-brass-light",
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>

    <!-- Full-screen mobile menu (outside header: its backdrop-blur would trap position:fixed) -->
    <nav
      id="nav-mobile"
      class="nav-sheet lg:hidden bg-canvas flex flex-col"
      aria-label="Mobile menu"
    >
      <div
        class="flex-1 flex flex-col justify-center overflow-y-auto px-6 pt-32 pb-6 mx-auto w-full max-w-md"
      >
        {
          NAV.map((item, i) => (
            <a
              href={item.href}
              class:list={[
                "nav-sheet-item flex items-baseline gap-4 border-b border-bronze-deep/10 py-4 font-heading font-bold uppercase tracking-wide text-2xl",
                currentPath === item.href
                  ? "text-copper-aged"
                  : "text-steel-charcoal",
              ]}
              style={`--stagger: ${i}`}
            >
              <span class="font-mono text-sm text-copper-aged/60 tabular-nums">
                {String(i + 1).padStart(2, "0")}
              </span>
              {item.label}
            </a>
          ))
        }
      </div>
      <div
        class="nav-sheet-item px-6 pb-10 mx-auto w-full max-w-md"
        style={`--stagger: ${NAV.length}`}
      >
        <div class="flex flex-wrap gap-3">
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            class="font-heading inline-flex items-center justify-center rounded bg-copper-aged px-5 py-2.5 text-sm font-semibold text-white"
          >
            WhatsApp
          </a>
          <a
            href={telLink}
            class="font-heading inline-flex items-center justify-center rounded border border-copper-aged px-5 py-2.5 text-sm font-semibold text-copper-aged"
          >
            Call {SITE.phoneDisplay}
          </a>
        </div>
        <p class="mt-5 text-sm text-slate-industrial/80">{SITE.address}</p>
      </div>
    </nav>

    <main class="flex-1 pt-16 lg:pt-28">
      <slot />
    </main>

    <footer class="bg-steel-charcoal text-white/70">
      <div
        class="mx-auto max-w-7xl px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4"
      >
        <div>
          <img
            src="/images/logo/logo.png"
            alt={`${SITE.name} — Since 1985`}
            class="h-17 w-auto rounded bg-[#ded9d5] p-2"
          />
          <p class="mt-4 text-sm leading-relaxed">
            Since 1985, we've dealt in scrap of every type and size — metals,
            materials and heavy vehicles. Every tonne we recycle is a step
            towards a greener tomorrow.
          </p>
        </div>
        <div>
          <h3
            class="font-heading text-xs font-bold uppercase tracking-widest text-brass-light"
          >
            Quick Links
          </h3>
          <ul class="mt-4 space-y-2.5 text-sm">
            {
              NAV.filter((i) => i.href !== "/").map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center gap-2 hover:text-white transition-colors duration-200"
                  >
                    <svg
                      class="h-3.5 w-3.5 shrink-0 text-brass-light"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m9 6 6 6-6 6" />
                    </svg>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3
            class="font-heading text-xs font-bold uppercase tracking-widest text-brass-light"
          >
            Services
          </h3>
          <ul class="mt-4 space-y-2 text-sm">
            {
              [
                {
                  label: "All Types of Plastic Scrap",
                  href: "/services#plastic-scrap",
                },
                {
                  label: "All Types of Tyre Scrap",
                  href: "/services#tyre-scrap",
                },
                {
                  label: "All Types of Waste Paper",
                  href: "/services#waste-paper",
                },
                {
                  label: "Aluminium & Copper Cable Scrap",
                  href: "/services#cable-scrap",
                },
                { label: "Aluminium Scrap", href: "/services#aluminium-scrap" },
                { label: "Brass Scrap", href: "/services#brass-scrap" },
                { label: "Copper Scrap", href: "/services#copper-scrap" },
                {
                  label: "Heavy Motor & Compressor Scrap",
                  href: "/services#motor-compressor-scrap",
                },
                {
                  label: "Heavy Truck Scrap",
                  href: "/vehicle-scrap#heavy-truck-scrap",
                },
                { label: "Iron Scrap", href: "/services#iron-scrap" },
                {
                  label: "Mining Machinery Scrap (Poclain, Loader, Excavator)",
                  href: "/vehicle-scrap#mining-machinery-scrap",
                },
                {
                  label: "Mixed Industrial Scrap",
                  href: "/services#mixed-industrial-scrap",
                },
                {
                  label: "Road Construction Scrap",
                  href: "/services#road-construction-scrap",
                },
                {
                  label: "Stainless Steel Scrap",
                  href: "/services#stainless-steel-scrap",
                },
              ].map((service) => (
                <li>
                  <a
                    href={service.href}
                    class="flex items-start gap-2 hover:text-white transition-colors duration-200"
                  >
                    <svg
                      class="h-3.5 w-3.5 shrink-0 mt-1 text-brass-light"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m9 6 6 6-6 6" />
                    </svg>
                    {service.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3
            class="font-heading text-xs font-bold uppercase tracking-widest text-brass-light"
          >
            Reach Us
          </h3>
          <ul class="mt-4 space-y-5 text-sm">
            {
              CONTACTS.map((contact) => (
                <li>
                  <p class="font-semibold text-white">{contact.name}</p>
                  <a
                    href={`tel:${contact.phoneE164}`}
                    class="mt-1.5 flex items-center gap-2 hover:text-white transition-colors duration-200 tabular-nums"
                  >
                    <svg
                      class="h-4 w-4 shrink-0 text-brass-light"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z" />
                    </svg>
                    {contact.phoneDisplay}
                  </a>
                  <a
                    href={`mailto:${contact.email}`}
                    class="mt-1.5 flex items-center gap-2 hover:text-white transition-colors duration-200"
                  >
                    <svg
                      class="h-4 w-4 shrink-0 text-brass-light"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="m3 7 9 6 9-6" />
                    </svg>
                    <span class="break-all">{contact.email}</span>
                  </a>
                </li>
              ))
            }
            <li class="flex items-start gap-2">
              <svg
                class="h-4 w-4 shrink-0 mt-0.5 text-brass-light"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {SITE.address}
            </li>
            <li>
              <a
                href={whatsappLink()}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 hover:text-white transition-colors duration-200"
              >
                <svg
                  class="h-4 w-4 shrink-0 text-brass-light"
                  viewBox="0 0 32 32"
                  fill="currentColor"
                >
                  <path
                    d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.5c1.2.6 2.5.9 3.8.9 6.6 0 12-5.4 12-12S22.6 3 16 3zm5.4 14.7c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 3 1.2 3 .8 3.6.8.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.6-.3z"
                  ></path>
                </svg>
                Chat on WhatsApp
              </a>
            </li>
            <li class="flex items-center gap-2">
              <svg
                class="h-4 w-4 shrink-0 text-brass-light"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 3"></path>
              </svg>
              {SITE.hours}
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <div
          class="mx-auto max-w-7xl px-4 sm:px-6 py-4 flex flex-wrap items-center justify-center gap-2 text-xs text-white/50"
        >
          <p
            class="flex flex-wrap items-center justify-center gap-1 text-center"
          >
            Copyright © {new Date().getFullYear()}
            {SITE.name}. {SITE.motto}. Developed & Maintained By

            <span class="inline-flex items-center gap-2">
              <a
                href="https://irad.solutions/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center"
              >
                <img
                  src="/images/logo/irad_logo.jpeg"
                  alt="IRAD Solutions"
                  class="h-6 w-auto object-contain"
                />
              </a>
              <a href={telLink} class="hover:text-canvas">+919977079639</a>
              |
              <a href={telLink} class="hover:text-canvas">+919238153364</a>
            </span>
          </p>
        </div>
      </div>
    </footer>

    <FloatingWhatsApp />

    <script>
      const toggle = document.getElementById("nav-toggle");
      const mobileNav = document.getElementById("nav-mobile");
      const setMenu = (open: boolean) => {
        mobileNav?.classList.toggle("open", open);
        toggle?.setAttribute("aria-expanded", String(open));
        toggle?.classList.toggle("menu-open", open);
        document.body.classList.toggle("overflow-hidden", open);
      };
      toggle?.addEventListener("click", () =>
        setMenu(!mobileNav?.classList.contains("open")),
      );
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && mobileNav?.classList.contains("open")) {
          setMenu(false);
        }
      });

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document
        .querySelectorAll("[data-reveal]")
        .forEach((el) => observer.observe(el));

      // Count-up numbers (StatBlock) when they scroll into view.
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const countObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            countObserver.unobserve(el);
            const target = Number(el.dataset.countup || "0");
            const fmt = (n: number) => n.toLocaleString("en-IN");
            if (reduceMotion || !target) {
              el.textContent = fmt(target);
              continue;
            }
            const duration = 1600;
            const t0 = performance.now();
            const tick = (now: number) => {
              const p = Math.min((now - t0) / duration, 1);
              el.textContent = fmt(
                Math.round(target * (1 - Math.pow(1 - p, 3))),
              );
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.6 },
      );
      document
        .querySelectorAll("[data-countup]")
        .forEach((el) => countObserver.observe(el));
    </script>
  </body>
</html>
