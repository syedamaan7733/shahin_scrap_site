---
import { CLIENTS } from '../config/site';

// Repeat the logo set so the 50% translate loop is seamless even with few logos.
const loop = [...CLIENTS, ...CLIENTS, ...CLIENTS, ...CLIENTS];
---

<div class="marquee py-6" aria-label="Companies we have worked with">
  <div class="marquee-track items-center gap-16 pr-16">
    {
      [...loop, ...loop].map((client) => (
        <img
          src={client.logo}
          alt={client.name}
          title={client.name}
          loading="lazy"
          class="h-12 sm:h-14 w-auto shrink-0 object-contain grayscale-25 hover:grayscale-0 transition"
        />
      ))
    }
  </div>
</div>
