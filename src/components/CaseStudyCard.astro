---
interface Props {
  title: string;
  sector: string;
  scope: string;
  stat: string;
  image: string;
  href: string;
}
const { title, sector, scope, stat, image, href } = Astro.props;
---

<a
  href={href}
  class="group block overflow-hidden rounded-lg border border-bronze-deep/15 bg-white shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all"
  data-reveal
>
  <div class="aspect-[16/9] overflow-hidden bg-brass-light/20">
    <img
      src={image}
      alt={title}
      loading="lazy"
      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
  </div>
  <div class="p-5">
    <span
      class="inline-block rounded bg-copper-aged/10 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-copper-aged"
      >{sector}</span
    >
    <h3 class="mt-3 font-heading font-semibold text-lg text-steel-charcoal">
      {title}
    </h3>
    <p class="mt-2 text-sm text-slate-industrial">{scope}</p>
    <p class="mt-3 font-mono text-sm text-amber-signal tabular-nums">{stat}</p>
  </div>
</a>
