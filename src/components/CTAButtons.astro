---
import { whatsappLink, telLink } from '../config/site';

interface Props {
  message?: string;
  center?: boolean;
}
const { message, center = false } = Astro.props;
---

<div
  class:list={['flex flex-wrap items-center gap-3', center && 'justify-center']}
>
  <a
    href={whatsappLink(message)}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded bg-amber-signal px-6 py-3 font-semibold text-steel-charcoal shadow hover:scale-105 transition-transform"
  >
    <svg class="h-5 w-5" viewBox="0 0 32 32" fill="currentColor">
      <path
        d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.5c1.2.6 2.5.9 3.8.9 6.6 0 12-5.4 12-12S22.6 3 16 3zm5.4 14.7c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5s-.7-1.7-1-2.3c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 3 1.2 3 .8 3.6.8.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.6-.3z"
      ></path>
    </svg>
    Chat on WhatsApp
  </a>
  <a
    href={telLink}
    class="inline-flex items-center gap-2 rounded border-2 border-current px-6 py-3 font-semibold hover:bg-steel-charcoal/5 transition-colors"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"
      ></path>
    </svg>
    Call Now
  </a>
</div>
