---
interface Props {
  value: string;
  label: string;
  light?: boolean;
}
const { value, label, light = false } = Astro.props;
// Numeric values count up from 0 when scrolled into view (see BaseLayout).
const counted = value.match(/^([\d,]+)(.*)$/);
---

<div class="text-center" data-reveal>
  <p
    class:list={[
      'font-mono text-2xl sm:text-3xl font-medium tabular-nums',
      light ? 'text-gold-pale' : 'text-copper-aged',
    ]}
  >
    {
      counted ? (
        <>
          <span data-countup={counted[1].replace(/,/g, '')}>0</span>
          {counted[2]}
        </>
      ) : (
        value
      )
    }
  </p>
  <p
    class:list={[
      'mt-1 text-xs sm:text-sm uppercase tracking-wide',
      light ? 'text-brass-light/80' : 'text-slate-industrial',
    ]}
  >
    {label}
  </p>
</div>
