---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MaterialCard from '../components/MaterialCard.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import CTABand from '../components/CTABand.astro';

const materials = [
  {
    title: 'Iron & Steel',
    blurb:
      'Structural offcuts, rebar, plate, machine parts and heavy melting scrap — graded and weighed on certified weighbridges.',
    image: '/images/materials/iron.jpg',
  },
  {
    title: 'Copper',
    blurb:
      'Cable, windings, busbar and mixed copper scrap. High-value material handled with itemised documentation.',
    image: '/images/materials/copper.jpg',
  },
  {
    title: 'Brass',
    blurb:
      'Fittings, valves, turnings and mixed brass — segregated and graded before weighment.',
    image: '/images/materials/brass.jpg',
  },
  {
    title: 'Aluminium',
    blurb:
      'Sections, sheets, radiators, utensil grade and cast aluminium from industrial and vehicle sources.',
    image: '/images/materials/aluminium.jpg',
  },
  {
    title: 'Plastic',
    blurb:
      'Industrial plastic scrap, HDPE drums, pipes and packaging — baled and moved in volume.',
    image: '/images/materials/plastic.jpg',
  },
  {
    title: 'Tyres',
    blurb:
      'Worn tyres from mining, highway and construction fleets, cleared in bulk from site yards.',
    image: '/images/materials/tyres.jpg',
  },
  {
    title: 'Mixed Industrial Scrap',
    blurb:
      'Plant clean-outs, demolition recovery and general mixed scrap — surveyed, sorted and lifted end-to-end.',
    image: '/images/materials/mixed.jpg',
  },
];
---

<BaseLayout title="Services — Metals, Materials & Contractual Scrap">
  <PageHero
    title="Our Services"
    sub="Metals, materials & contractual scrap"
    image="/images/materials/mixed.jpg"
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-16 pb-10">
    <p class="mx-auto max-w-3xl text-center text-slate-industrial" data-reveal>
      Industrial-scale scrap procurement from a Surguja-based operator — spot
      purchases or fixed-rate contracts, always with certified weighment and
      GST invoicing.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 pb-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {materials.map((m) => <MaterialCard {...m} />)}
    </div>
  </section>

  <!-- Contractual pricing model -->
  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
      <SectionHeading
        title="The Contractual Pricing Model"
        sub="For industrial, construction and road-building firms that generate scrap continuously, we fix rates for the contract duration — no renegotiation every lifting, no rate surprises."
      />
      <div class="mt-8 grid gap-6 sm:grid-cols-3" data-reveal>
        <div class="rounded-lg bg-white p-6 shadow-sm border border-bronze-deep/10">
          <p class="font-mono text-copper-aged font-medium">01</p>
          <h3 class="mt-2 font-heading font-semibold">Rates locked for the term</h3>
          <p class="mt-2 text-sm text-slate-industrial">
            Per-material rates agreed once and held for the full contract
            period, regardless of market movement.
          </p>
        </div>
        <div class="rounded-lg bg-white p-6 shadow-sm border border-bronze-deep/10">
          <p class="font-mono text-copper-aged font-medium">02</p>
          <h3 class="mt-2 font-heading font-semibold">Scheduled lifting</h3>
          <p class="mt-2 text-sm text-slate-industrial">
            Liftings on a fixed schedule or on call — our transport, our
            manpower, your yard stays clear.
          </p>
        </div>
        <div class="rounded-lg bg-white p-6 shadow-sm border border-bronze-deep/10">
          <p class="font-mono text-copper-aged font-medium">03</p>
          <h3 class="mt-2 font-heading font-semibold">Cycle settlement</h3>
          <p class="mt-2 text-sm text-slate-industrial">
            Weighbridge slips and GST invoices per consignment, settled on the
            agreed payment cycle.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflows -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16 space-y-12">
    <SectionHeading
      title="Our Operation Workflows"
      sub="Two ways to work with us — one-time spot purchase, or a fixed-rate contract."
    />
    <WorkflowDiagram
      title="Spot Purchase Flow"
      steps={['Enquiry', 'Site Survey', 'Weight & Grade', 'Quote', 'Lift', 'Payment']}
    />
    <WorkflowDiagram
      title="Contract Flow (rate fixed for term)"
      steps={['Enquiry', 'Site Survey', 'Rate Negotiation', 'Contract', 'Scheduled Lifting', 'Cycle Settlement']}
    />
  </section>

  <!-- Who this is for -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pb-16">
    <div
      class="rounded-lg border border-copper-aged/30 bg-white p-8"
      data-reveal
    >
      <h3 class="font-heading font-semibold text-xl">Who this is for</h3>
      <p class="mt-3 text-slate-industrial">
        Mining sites · Industrial plants · Road & construction contractors ·
        Demolition projects · Government auctions (MSTC portal)
      </p>
    </div>
  </section>

  <CTABand
    heading="Discuss a materials contract"
    message="Hello Shahin Scrap, I'd like to discuss a materials scrap contract."
  />
</BaseLayout>
