---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CTABand from "../components/CTABand.astro";
import { CLIENTS } from "../config/site";

const sectors = [
  {
    name: "Public-Sector Coal & Mining",
    image: "/images/sectors/coal-mining.jpg",
    detail:
      "End-to-end auction-based procurement, lifting and responsible disposal of scrap, obsolete machinery and end-of-life equipment for public-sector mining companies and their subsidiaries operating across the Surguja coal belt and surrounding regions.",
  },
  {
    name: "Private Mining Conglomerates",
    image: "/images/sectors/private-mining.jpg",
    detail:
      "Structured scrap-management and asset-disposal programmes for private mining operators, covering ferrous and non-ferrous scrap, obsolete machinery, worn-out components and end-of-life equipment with efficient site clearance and logistics support.",
  },
  {
    name: "Road & Highway Contractors",
    image: "/images/sectors/road-highway.jpg",
    detail:
      "Ongoing site-clearance and scrap-lifting services for road, highway and infrastructure projects, including shuttering materials, reinforcement steel, used tyres, machinery parts, fabrication waste and other recoverable construction-site materials.",
  },
  {
    name: "Industrial Plants",
    image: "/images/sectors/industrial-plants.jpg",
    detail:
      "Reliable procurement and clearance of industrial scrap through fixed-rate and contractual arrangements, including process-generated scrap, obsolete plant and machinery, maintenance waste, plant clean-outs and material recovery from decommissioning projects.",
  },
  {
    name: "Government Auctions (MSTC)",
    image: "/images/sectors/mstc.jpg",
    detail:
      "Active participation in government and public-sector e-auctions conducted through the MSTC portal, supported by complete documentation, regulatory compliance, timely payments and organised lifting of awarded materials from designated sites.",
  },
  {
    name: "Civil / General",
    image: "/images/sectors/civil-general.jpg",
    detail:
      "Comprehensive scrap procurement and clearance services for civil works, commercial projects and general industries, including demolition recovery, structural steel, mixed metal scrap, surplus materials and bulk site-clearance requirements.",
  },
];
---

<BaseLayout title="Companies We've Worked With">
  <PageHero
    title="Companies We've Worked With"
    sub="Four decades of engagements — many of them repeat, long-term contracts"
    image="/images/case-studies/cs-metal.jpg"
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-16 pb-16">
    <div
      class="grid grid-cols-1 sm:grid-cols-3 items-center gap-10 rounded-lg border border-bronze-deep/15 bg-white p-10"
      data-reveal
    >
      {
        CLIENTS.map((client) => (
          <div class="flex items-center justify-center">
            <img
              src={client.logo}
              alt={client.name}
              title={client.name}
              loading="lazy"
              class="max-h-20 w-auto object-contain"
            />
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-slate-industrial/70 text-center">
      More associations added as engagements formalise.
    </p>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
      <SectionHeading title="Sectors We Serve" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          sectors.map((s) => (
            <div
              class="group overflow-hidden rounded-lg border border-bronze-deep/10 bg-white shadow-sm"
              data-reveal
            >
              <div class="aspect-[16/9] overflow-hidden bg-brass-light/20">
                <img
                  src={s.image}
                  alt={s.name}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-6">
                <h3 class="font-heading font-semibold text-steel-charcoal">
                  {s.name}
                </h3>
                <p class="mt-2 text-sm text-slate-industrial">{s.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
    <div
      class="rounded-lg border border-copper-aged/30 bg-white p-8"
      data-reveal
    >
      <h3 class="font-heading font-semibold text-xl">
        Built on repeat engagements
      </h3>
      <p class="mt-3 text-slate-industrial">
        Most of our contract relationships extend beyond their first term.
        Clients stay because rates hold as agreed, liftings happen on schedule,
        and every consignment closes with clean documentation — the basics, done
        consistently for 40 years.
      </p>
    </div>
  </section>

  <CTABand heading="Add your company to this list" />
</BaseLayout>
