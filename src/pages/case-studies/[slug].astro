---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABand from '../../components/CTABand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.id },
    props: { cs },
  }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);
---

<BaseLayout title={cs.data.title} description={cs.data.scope}>
  <section class="relative">
    <div class="aspect-[21/9] max-h-[420px] w-full overflow-hidden bg-brass-light/20">
      <img
        src={cs.data.image}
        alt={cs.data.title}
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-12">
    <a
      href="/case-studies"
      class="text-sm font-semibold text-copper-aged hover:text-amber-signal"
      >← All case studies</a
    >
    <span
      class="mt-6 block w-fit rounded bg-copper-aged/10 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-copper-aged"
      >{cs.data.sector}</span
    >
    <h1
      class="mt-4 font-heading font-bold text-3xl sm:text-4xl text-steel-charcoal"
    >
      {cs.data.title}
    </h1>

    <div
      class="mt-8 grid grid-cols-3 gap-4 rounded-lg border border-bronze-deep/15 bg-white p-6"
    >
      {
        cs.data.stats.map((s) => (
          <div class="text-center">
            <p class="font-mono text-xl sm:text-2xl text-amber-signal tabular-nums">
              {s.value}
            </p>
            <p class="mt-1 text-xs uppercase tracking-wide text-slate-industrial">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>

    <article
      class="prose-headings:font-heading mt-10 space-y-4 [&_h2]:font-heading [&_h2]:font-semibold [&_h2]:text-xl [&_h2]:text-steel-charcoal [&_h2]:mt-8 [&_p]:text-slate-industrial [&_p]:leading-relaxed"
    >
      <Content />
    </article>
  </section>

  <CTABand
    heading="Planning a similar project?"
    message={`Hello Shahin Scrap, I'd like to discuss a project similar to: ${cs.data.title}`}
  />
</BaseLayout>
