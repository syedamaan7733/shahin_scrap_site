---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MaterialCard from '../components/MaterialCard.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import CTABand from '../components/CTABand.astro';
---

<BaseLayout title="Vehicle & Heavy Equipment Scrap">
  <PageHero
    title="Vehicle & Equipment Scrap"
    sub="End-of-life mining vehicles, dismantled under formal contract"
    image="/images/vehicles/construction.jpg"
  />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-16 pb-10">
    <p class="mx-auto max-w-3xl text-center text-slate-industrial" data-reveal>
      End-of-life mining and heavy-equipment scrapping under formal contracts —
      on-site dismantling, certified weighment, and complete disposal
      documentation.
    </p>
    <div
      class="mt-8 rounded-lg border-l-4 border-copper-aged bg-white p-5 shadow-sm"
      data-reveal
    >
      <p class="text-sm text-slate-industrial">
        <strong class="text-steel-charcoal">Service area note:</strong> mining
        vehicle and heavy-equipment contracts are serviced across regions.
        Commercial truck and trailer scrap is handled
        <strong class="text-steel-charcoal"
          >within Surguja and adjacent districts only</strong
        >.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 pb-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <MaterialCard
        title="Mining Vehicles"
        blurb="Dozers, Poclain (excavators), dumpers and loaders — auction lots or direct contracts, serviced pan-region."
        image="/images/vehicles/mining.jpg"
      />
      <MaterialCard
        title="Construction Equipment"
        blurb="Retired construction machinery, cranes and plant equipment — dismantled and cleared from site, serviced pan-region."
        image="/images/vehicles/construction.jpg"
      />
      <MaterialCard
        title="Commercial Trucks & Trailers"
        blurb="End-of-life highway trucks and trailers — Surguja and adjacent districts only."
        image="/images/vehicles/trucks.jpg"
      />
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
      <SectionHeading title="Vehicle Scrapping Workflow" />
      <div class="mt-8">
        <WorkflowDiagram
          steps={['On-site Assessment', 'Valuation', 'Contract', 'Cutting & Lifting', 'Regulatory Disposal Documentation']}
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
    <div
      class="rounded-lg border border-copper-aged/30 bg-white p-8"
      data-reveal
    >
      <h3 class="font-heading font-semibold text-xl">
        Why a formal partner matters
      </h3>
      <p class="mt-3 text-slate-industrial">
        Informal scrapping leaves your organisation without a disposal trail.
        Every Shahin Scrap vehicle contract closes with GST invoices, weighbridge
        records, and disposal certificates — the chain-of-custody your audit and
        compliance teams need.
      </p>
    </div>
  </section>

  <CTABand
    heading="Have equipment to decommission?"
    sub="Send us the vehicle list — we'll survey, value, and quote."
    message="Hello Shahin Scrap, I'd like to discuss vehicle/equipment scrapping."
  />
</BaseLayout>
