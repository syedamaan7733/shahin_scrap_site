---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBlock from '../components/StatBlock.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import CTAButtons from '../components/CTAButtons.astro';
import CTABand from '../components/CTABand.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('case-studies'))
  .sort((a, b) => a.data.order - b.data.order)
  .find((cs) => cs.data.featured);

const serviceCards = [
  {
    title: 'Iron Scrap',
    image: '/images/services/iron.jpg',
    href: '/services',
    desc: 'From rusted sheets and rods to heavy structural steel — every grade of iron scrap, weighed on certified bridges and paid at honest market rates.',
  },
  {
    title: 'Copper Scrap',
    image: '/images/services/copper.jpg',
    href: '/services',
    desc: "Bright wire, pipes, motors and mixed copper — carefully graded, honestly weighed and paid at the day's best rate. From one bag to a truckload.",
  },
  {
    title: 'Aluminium Scrap',
    image: '/images/services/aluminium.jpg',
    href: '/services',
    desc: 'Utensils, sheets, sections, castings and machine parts — every form of aluminium bought at fair rates, from household lots to industrial consignments.',
  },
  {
    title: 'Brass Scrap',
    image: '/images/services/brass.jpg',
    href: '/services',
    desc: 'Armatures, fittings, valves, taps and mixed brass — carefully sorted and graded so you get full value for every kilogram.',
  },
  {
    title: 'Plastic Scrap',
    image: '/images/services/plastic.jpg',
    href: '/services',
    desc: 'Household, commercial and industrial plastic of every type — collected, sorted and sent for responsible recycling instead of the landfill.',
  },
  {
    title: 'Tyre Scrap',
    image: '/images/services/tyres.jpg',
    href: '/services',
    desc: 'From scooter tyres to giant mining tyres — every size and any count accepted, cleared quickly from your yard or site.',
  },
  {
    title: 'Mining Machinery Scrap',
    image: '/images/services/mining-machinery.jpg',
    href: '/vehicle-scrap',
    desc: 'Poclain, loaders, excavators and dumpers that have done their duty — we dismantle them safely at site and haul every tonne away.',
  },
  {
    title: 'Heavy Truck Scrap',
    image: '/images/services/heavy-truck.jpg',
    href: '/vehicle-scrap',
    desc: 'Retired trucks, tippers and dumpers bought outright — dismantled by our own team, with complete papers and on-time payment.',
  },
  // Below the fold — revealed by the "show more" arrow.
  {
    title: 'Stainless Steel Scrap',
    image: '/images/services/stainless-steel.jpg',
    href: '/services',
    desc: 'Kitchen, dairy, hospital and fabrication stainless steel of every grade — weighed transparently and paid at true market value.',
  },
  {
    title: 'Heavy Motor & Compressor Scrap',
    image: '/images/services/motor-compressor.jpg',
    href: '/services',
    desc: 'Burnt-out motors, compressors and electrical machinery of any size — from single units to container loads, picked up and paid for fairly.',
  },
  {
    title: 'Aluminium & Copper Cable Scrap',
    image: '/images/services/cables.jpg',
    href: '/services',
    desc: 'Armoured, insulated and bare cables — aluminium or copper — bought by weight with honest recovery rates and no hidden cuts.',
  },
  {
    title: 'Waste Paper',
    image: '/images/services/waste-paper.jpg',
    href: '/services',
    desc: 'Newspapers, cartons, office records and press waste — compressed on our own baling machine into neat bales for clean, efficient recycling.',
  },
  {
    title: 'Mixed Industrial Scrap',
    image: '/images/services/mixed-industrial.jpg',
    href: '/services',
    desc: "Unsorted plant and factory scrap lifted straight from your floor — our grabs sort, grade and load it so you don't lift a finger.",
  },
  {
    title: 'Road Construction Scrap',
    image: '/images/services/road-construction.jpg',
    href: '/services',
    desc: 'Barriers, rebar, plates and leftover site material — we clear road and civil project sites quickly so your next job starts on time.',
  },
  {
    title: 'Construction Equipment',
    image: '/images/services/construction-equipment.jpg',
    href: '/vehicle-scrap',
    desc: 'Rollers, mixers, cranes and breakers past their working life — broken down safely by our team and turned into documented value.',
  },
  {
    title: 'Commercial Trucks & Trailers',
    image: '/images/services/commercial-trucks.jpg',
    href: '/vehicle-scrap',
    desc: 'Old fleets, vans and trailers rusting in your lot — we buy them as they stand, tow them away and handle every paper.',
  },
];
---

<BaseLayout title="Home">
  <!-- Hero carousel -->
  <section
    id="hero-carousel"
    class="hero-carousel relative min-h-[calc(100vh-7rem)] overflow-hidden select-none"
  >
  <div class="absolute inset-0" aria-hidden="true">
    <div
      class="carousel-bg active"
      style="background-image: linear-gradient(100deg, rgba(14,12,10,0.55) 0%, rgba(14,12,10,0.25) 55%, rgba(14,12,10,0.05) 100%), url('/images/hero/scrap-yard.jpg');"
    >
    </div>

    <div
      class="carousel-bg"
      style="background-image: linear-gradient(100deg, rgba(14,12,10,0.55) 0%, rgba(14,12,10,0.25) 55%, rgba(14,12,10,0.05) 100%), url('/images/hero/vehicle-claw.jpg');"
    >
    </div>

    <div
      class="carousel-bg"
      style="background-image: linear-gradient(100deg, rgba(14,12,10,0.55) 0%, rgba(14,12,10,0.25) 55%, rgba(14,12,10,0.05) 100%), url('/images/hero/grab-crane.jpg');"
    >
    </div>
  </div>

    <div
      id="hero-track"
      class="carousel-track relative z-10 flex min-h-[calc(100vh-7rem)]"
    >
      <div class="carousel-slide min-w-full flex items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-24 text-canvas">
          <span
            class="hero-glass font-heading inline-block rounded-md px-3 py-2 text-xs font-bold uppercase tracking-[0.25em] text-brass-light"
          >
            Surguja · Chhattisgarh
          </span>
          <h1
            class="mt-6 max-w-3xl font-heading font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-tight"
          >
            One of the Biggest Metal Scrap Dealers in Surguja. Trusted Since
            1985.
          </h1>
          <p
            class="hero-glass mt-6 max-w-2xl rounded-lg px-4 py-3 text-lg text-white/90"
          >
            Big or small, we buy it all — from factory and mine scrap to the
            old metal lying at your home. Fair rates, honest weighing, since
            1985.
          </p>
          <div class="mt-9 inline-block rounded-xl p-2.5">
            <CTAButtons />
          </div>
        </div>
      </div>

      <div class="carousel-slide min-w-full flex items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-24 text-canvas">
          <span
            class="hero-glass font-heading inline-block rounded-md px-3 py-2 text-xs font-bold uppercase tracking-[0.25em] text-brass-light"
          >
            Vehicles & Machines
          </span>
          <h2
            class="mt-6 max-w-3xl font-heading font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-tight"
          >
            Old Vehicles? We Turn Them Into Value.
          </h2>
          <p
            class="hero-glass mt-6 max-w-2xl rounded-lg px-4 py-3 text-lg text-white/90"
          >
            Cars, trucks, buses and mining & industrial machines such as
            Poclain, loaders and excavators — we pick them up, weigh them
            fairly and pay you on time, with all the paperwork done.
          </p>
          <div class=" mt-9 inline-block rounded-xl p-2.5">
            <CTAButtons />
          </div>
        </div>
      </div>

      <div class="carousel-slide min-w-full flex items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-24 text-canvas">
          <span
            class="hero-glass font-heading inline-block rounded-md px-3 py-2 text-xs font-bold uppercase tracking-[0.25em] text-brass-light"
          >
            Every Kind of Scrap · Every Scale
          </span>
          <h2
            class="mt-6 max-w-3xl font-heading font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-tight"
          >
            From One Sack to a Thousand Tonnes
          </h2>
          <p
            class="hero-glass mt-6 max-w-2xl rounded-lg px-4 py-3 text-lg text-white/90"
          >
            Iron, copper, aluminium, plastic, paper, tyres and more — we work
            with companies, contractors and everyday sellers alike.
          </p>
          <div class=" mt-9 inline-block rounded-xl p-2.5">
            <CTAButtons />
          </div>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-16 left-1/2 z-10 flex -translate-x-1/2 gap-2.5"
    >
      <button class="carousel-dot active" aria-label="Go to slide 1"></button>
      <button class="carousel-dot" aria-label="Go to slide 2"></button>
      <button class="carousel-dot" aria-label="Go to slide 3"></button>
    </div>

  </section>

  <!-- Highlights strip -->
  <section class="relative z-10 mx-auto -mt-12 max-w-6xl px-4 sm:px-6">
    <div class="grid overflow-hidden shadow-lg sm:grid-cols-3">
      <div class="bg-copper-aged px-8 py-9 text-center">
        <h3 class="font-heading text-lg font-bold text-white">
          Experienced & Professional
        </h3>
        <p class="mt-1 text-sm font-medium text-white/85">
          40 years in the scrap trade
        </p>
      </div>
      <div
        class="hidden sm:block bg-cover bg-center px-8 py-9 text-center"
        style="background-image: linear-gradient(rgba(20,18,16,0.78), rgba(20,18,16,0.78)), url('/images/materials/mixed.jpg');"
      >
        <h3 class="font-heading text-lg font-bold text-brass-light">
          Contract-Driven
        </h3>
        <p class="mt-1 text-sm text-white/85">Rates locked for the term</p>
      </div>
      <div
        class="hidden sm:block bg-cover bg-center px-8 py-9 text-center"
        style="background-image: linear-gradient(rgba(20,18,16,0.78), rgba(20,18,16,0.78)), url('/images/vehicles/trucks.jpg');"
      >
        <h3 class="font-heading text-lg font-bold text-brass-light">
          Fully Documented
        </h3>
        <p class="mt-1 text-sm text-white/85">
          GST invoices & weighbridge records
        </p>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="bg-surface -mt-24 pt-36 pb-20">
    <div
      class="mx-auto grid max-w-7xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1.7fr]"
    >
      <div data-reveal>
        <h2
          class="font-heading text-3xl font-bold text-steel-charcoal sm:text-4xl"
        >
          About Shahin Scrap
        </h2>
        <div class="mt-3 h-1 w-16 rounded bg-copper-aged"></div>
      </div>
      <div data-reveal>
        <p class="text-justify leading-relaxed text-slate-industrial">
          Shahin Scrap was started in the year 1985 as a scrap dealership in
          Ambikapur. Four decades on, the firm is one of the most recognised
          names in the scrap trade across Surguja district. What began with
          local metal purchases has grown into a contractual B2B operation
          serving mining companies, industrial plants, and road & construction
          contractors — with certified weighment, GST invoicing, and documented
          disposal on every consignment. And it isn't only for big companies:
          households and local sellers are just as welcome. Whether it's one
          old cooler or a full truckload, we weigh it fairly and pay you right.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/about"
            class="font-heading rounded-sm bg-ink px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-slate-industrial"
            >Learn More</a
          >
          <a
            href="/contact"
            class="font-heading rounded-sm bg-copper-aged px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:brightness-110"
            >Contact Us</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Our handling & services -->
  <section id="what-we-do" class="scroll-mt-28">
    <div class="bg-copper-aged py-7">
      <h2
        class="text-center font-heading text-2xl font-extrabold uppercase tracking-wide text-white sm:text-3xl"
      >
        Our Handling & Services
      </h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      {
        serviceCards.map((card, i) => (
          <a
            href={card.href}
            class:list={[
              'service-card group relative block overflow-hidden',
              i >= 8 && 'hidden service-card-extra',
            ]}
          >
            <div class="aspect-[4/3] overflow-hidden bg-steel-charcoal">
              <img
                src={card.image}
                alt={card.title}
                loading="lazy"
                class="service-img h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 group-focus-visible:scale-110"
              />
            </div>
            <div
              class="service-overlay absolute inset-0 flex flex-col items-center justify-center bg-black/40 px-4 text-center transition-colors duration-500 group-hover:bg-black/70 group-focus-visible:bg-black/70"
            >
              <h3
                class="font-heading text-sm sm:text-base font-bold uppercase tracking-wide text-white"
              >
                {card.title}
              </h3>
              <p
                class="service-desc mt-0 max-h-0 overflow-hidden text-xs sm:text-sm text-white/85 opacity-0 transition-all duration-500 group-hover:mt-2 group-hover:max-h-28 group-hover:opacity-100 group-focus-visible:mt-2 group-focus-visible:max-h-28 group-focus-visible:opacity-100"
              >
                {card.desc}
              </p>
            </div>
          </a>
        ))
      }
    </div>
    <div class="bg-surface py-6 text-center">
      <button
        id="services-toggle"
        class="group inline-flex flex-col items-center gap-1 font-heading text-xs font-bold uppercase tracking-wider text-copper-aged hover:text-bronze-deep transition-colors"
        aria-expanded="false"
        aria-label="Show all services"
      >
        <span data-label>Show All Services</span>
        <svg
          class="h-5 w-5 transition-transform duration-300 group-aria-expanded:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </button>
    </div>
  </section>

  <!-- How we work -->
  <section class="bg-surface">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-20">
      <SectionHeading
        title="How We Work"
        sub="Five things we bring to every job — big or small."
        center
      />
      <ol class="relative mt-12 space-y-10">
        <!-- vertical connector line -->
        <div
          class="absolute left-5 top-2 bottom-2 w-px bg-copper-aged/30"
          aria-hidden="true"
        >
        </div>
        {
          [
            {
              title: 'We Listen First',
              desc: 'Tell us what you have — a quick call or a WhatsApp photo is enough to get started.',
            },
            {
              title: 'We Come to You',
              desc: 'Our team visits your site, plant or home — anywhere in India.',
            },
            {
              title: 'Fair Weighing, Fair Price',
              desc: 'Certified weighbridges and transparent market rates. No guesswork, no haggling games.',
            },
            {
              title: 'We Do the Heavy Lifting',
              desc: 'Cutting, dismantling, loading, transport — our people and machines handle it all.',
            },
            {
              title: 'Paid & Documented',
              desc: 'On-time payment with GST invoices and complete paperwork, every single time.',
            },
          ].map((step, i) => (
            <li class="relative flex gap-6 pl-0" data-reveal>
              <span class="font-heading z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-copper-aged text-sm font-bold text-white shadow">
                {i + 1}
              </span>
              <div>
                <h3 class="font-heading text-lg font-bold text-steel-charcoal">
                  {step.title}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-industrial">
                  {step.desc}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Why us -->
  <section class="bg-canvas">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20">
      <SectionHeading
        title="Why Us"
        sub="What you get when Shahin Scrap handles your scrap."
        center
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              title: 'Professional Team',
              desc: 'Trained, experienced people on every job.',
              icon: 'M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2 M10 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M21 21v-2a4 4 0 0 0-3-3.87 M15 3.13a4 4 0 0 1 0 7.75',
            },
            {
              title: 'Quick Dismantling & Transportation',
              desc: 'Fast cutting, loading and lifting from your site.',
              icon: 'M10 17h4V5H2v12h3 M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1 M7.5 17a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z M17.5 17a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z',
            },
            {
              title: 'All Heavy Lifting By Us',
              desc: 'Our men and machines do the hard work — not you.',
              icon: 'M12 3v6 M8 6l4 3 4-3 M4 21h16 M6 21V11h12v10',
            },
            {
              title: 'Fair Market Price',
              desc: 'Transparent rates, certified weighing, no games.',
              icon: 'M12 3v18 M5 7h14 M5 7l-3 6a3 3 0 0 0 6 0l-3-6z M19 7l-3 6a3 3 0 0 0 6 0l-3-6z',
            },
            {
              title: 'No Delay In Payment',
              desc: 'You get paid on time, every time.',
              icon: 'M2 8h20v10H2z M2 8V6h16v2 M16 13a2 2 0 1 0 4 0 2 2 0 0 0-4 0z',
            },
            {
              title: 'Safety Is The Top Priority',
              desc: 'Careful, safe handling on every site, every load.',
              icon: 'M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z M9 12l2 2 4-4',
            },
          ].map((point) => (
            <div
              class="flex items-start gap-4 rounded-lg border border-copper-aged/15 bg-surface p-6"
              data-reveal
            >
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-copper-aged/10 text-copper-aged">
                <svg
                  class="h-6 w-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={point.icon} />
                </svg>
              </span>
              <div>
                <h3 class="font-heading font-bold text-steel-charcoal">
                  {point.title}
                </h3>
                <p class="mt-1 text-sm text-slate-industrial">{point.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Companies marquee -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
    <SectionHeading title="Companies We've Worked With" center />
    <div class="mt-8">
      <ClientMarquee />
    </div>
    <p class="mt-4 text-center">
      <a
        href="/companies"
        class="text-sm font-semibold text-copper-aged hover:text-bronze-warm"
        >See all sectors we serve →</a
      >
    </p>
  </section>

  <!-- Environmental strip -->
  <section class="bg-slate-industrial">
    <div
      class="mx-auto max-w-7xl px-4 sm:px-6 py-10 grid grid-cols-1 sm:grid-cols-3 gap-8"
    >
      <StatBlock light value="20 t" label="CO₂ Avoided Through Recycling" />
      <StatBlock light value="100%" label="Documented Consignments" />
      <StatBlock light value="MSTC" label="Auction & Compliance Ready" />
    </div>
  </section>

  <!-- Featured case study -->
  {
    featured && (
      <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20">
        <SectionHeading
          title="Featured Case Study"
          sub="How a fixed-rate contract turned plant scrap into predictable, documented revenue."
        />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <CaseStudyCard
            title={featured.data.title}
            sector={featured.data.sector}
            scope={featured.data.scope}
            stat={featured.data.stat}
            image={featured.data.image}
            href={`/case-studies/${featured.id}`}
          />
          <div class="flex items-center sm:col-span-1 lg:col-span-2">
            <a
              href="/case-studies"
              class="text-copper-aged font-semibold hover:text-copper-aged"
            >
              View all case studies →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <CTABand />
</BaseLayout>

<script>
  // Touch devices: first tap reveals a service card's description, second tap follows the link.
  if (window.matchMedia('(hover: none)').matches) {
    const cards = [...document.querySelectorAll('.service-card')];
    cards.forEach((card) =>
      card.addEventListener('click', (e) => {
        if (!card.classList.contains('touched')) {
          e.preventDefault();
          cards.forEach((c) => c.classList.remove('touched'));
          card.classList.add('touched');
        }
      })
    );
  }

  // "Show all services" expander
  const servicesToggle = document.getElementById('services-toggle');
  servicesToggle?.addEventListener('click', () => {
    const expanded = servicesToggle.getAttribute('aria-expanded') === 'true';
    document
      .querySelectorAll('.service-card-extra')
      .forEach((card) => card.classList.toggle('hidden', expanded));
    servicesToggle.setAttribute('aria-expanded', String(!expanded));
    const label = servicesToggle.querySelector('[data-label]');
    if (label)
      label.textContent = expanded ? 'Show All Services' : 'Show Less';
  });

  const section = document.getElementById('hero-carousel');
  const track = document.getElementById('hero-track');
  if (section && track) {
    const bgs = [...section.querySelectorAll('.carousel-bg')];
    const dots = [...section.querySelectorAll('.carousel-dot')];
    const count = dots.length;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const goTo = (i: number) => {
      index = (i + count) % count;
      track.style.transform = `translateX(-${index * 100}%)`;
      bgs.forEach((bg, n) => bg.classList.toggle('active', n === index));
      dots.forEach((dot, n) => dot.classList.toggle('active', n === index));
    };
    const stop = () => clearInterval(timer);
    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = setInterval(() => goTo(index + 1), 5000);
    };

    // Hold pauses auto-advance; releasing after a horizontal drag swipes.
    let startX: number | null = null;
    section.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      stop();
    });
    window.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (dx > 50) goTo(index - 1);
      else if (dx < -50) goTo(index + 1);
      start();
    });
    window.addEventListener('pointercancel', () => {
      startX = null;
      start();
    });

    dots.forEach((dot, n) =>
      dot.addEventListener('click', () => {
        goTo(n);
        start();
      })
    );
    start();
  }
</script>
