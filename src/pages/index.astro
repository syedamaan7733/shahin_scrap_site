---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBlock from '../components/StatBlock.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import CTAButtons from '../components/CTAButtons.astro';
import CTABand from '../components/CTABand.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { SITE } from '../config/site';
import { getCollection } from 'astro:content';

const featured = (await getCollection('case-studies'))
  .sort((a, b) => a.data.order - b.data.order)
  .find((cs) => cs.data.featured);

const handleTiles = [
  { title: 'Iron & Steel', image: '/images/materials/iron.jpg', href: '/services' },
  { title: 'Copper', image: '/images/materials/copper.jpg', href: '/services' },
  { title: 'Brass', image: '/images/materials/brass.jpg', href: '/services' },
  { title: 'Aluminium', image: '/images/materials/aluminium.jpg', href: '/services' },
  { title: 'Plastic', image: '/images/materials/plastic.jpg', href: '/services' },
  { title: 'Tyres', image: '/images/materials/tyres.jpg', href: '/services' },
  { title: 'Mining Vehicles', image: '/images/vehicles/mining.jpg', href: '/vehicle-scrap' },
  { title: 'Highway Trucks', image: '/images/vehicles/trucks.jpg', href: '/vehicle-scrap' },
];
---

<BaseLayout title="Metal, Material & Vehicle Scrap — Surguja, Chhattisgarh">
  <!-- Hero carousel -->
  <section
    id="hero-carousel"
    class="hero-carousel relative min-h-[calc(100vh-7rem)] overflow-hidden select-none"
  >
  <div class="absolute inset-0" aria-hidden="true">
    <div
      class="carousel-bg active"
      style="background-image: linear-gradient(rgba(14,12,10,0.6), rgba(14,12,10,0.6)), url('/images/hero/home.jpg');"
    >
    </div>

    <div
      class="carousel-bg"
      style="background-image: linear-gradient(rgba(14,12,10,0.6), rgba(14,12,10,0.6)), url('/images/vehicles/mining.jpg');"
    >
    </div>

    <div
      class="carousel-bg"
      style="background-image: linear-gradient(rgba(14,12,10,0.6), rgba(14,12,10,0.6)), url('/images/materials/iron.jpg');"
    >
    </div>
  </div>

    <div
      id="hero-track"
      class="carousel-track relative z-10 flex min-h-[calc(100vh-7rem)]"
    >
      <div class="carousel-slide min-w-full flex items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-24 text-canvas">
          <span
            class="font-heading inline-block text-xs font-bold uppercase tracking-[0.25em] text-brass-light"
          >
            {SITE.motto}
          </span>
          <h1
            class="mt-6 max-w-3xl font-heading font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-tight"
          >
          Trusted Since 1985. Built for Businesses That Build India.
          </h1>
          <p class="mt-6 max-w-2xl text-lg text-white/80">
            Contractual scrap solutions from Ambikapur, Surguja — metals,
            materials, and end-of-life mining vehicles, handled formally with
            full documentation.
          </p>
          <div class="mt-9">
            <CTAButtons />
          </div>
        </div>
      </div>

      <div class="carousel-slide min-w-full flex items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-24 text-canvas">
          <span
            class="font-heading inline-block text-xs font-bold uppercase tracking-[0.25em] text-brass-light"
          >
            Surguja · Chhattisgarh
          </span>
          <h2
            class="mt-6 max-w-3xl font-heading font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-tight"
          >
            One of the Biggest Metal Scrap Dealers in Surguja
          </h2>
          <p class="mt-6 max-w-2xl text-lg text-white/80">
            Serving mining companies, PSUs, and industrial clients across
            Surguja district with documented, GST-compliant contracts since
            1985.
          </p>
          <div class="mt-9">
            <CTAButtons />
          </div>
        </div>
      </div>

      <div class="carousel-slide min-w-full flex items-center">
        <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 py-24 text-canvas">
          <span
            class="font-heading inline-block text-xs font-bold uppercase tracking-[0.25em] text-brass-light"
          >
            Industrial to Local
          </span>
          <h2
            class="mt-6 max-w-3xl font-heading font-extrabold tracking-tight text-4xl sm:text-5xl lg:text-6xl leading-tight"
          >
            Metals, Plastics & Industrial Scrap — From Mine to Market
          </h2>
          <p class="mt-6 max-w-2xl text-lg text-white/80">
            We serve industrial clients, local businesses, and general sellers
            — iron, copper, brass, plastic, and tyres — all weighed on
            certified bridges.
          </p>
          <div class="mt-9">
            <CTAButtons />
          </div>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-16 left-1/2 z-10 flex -translate-x-1/2 gap-2.5"
    >
      <button class="carousel-dot active" aria-label="Go to slide 1"></button>
      <button class="carousel-dot" aria-label="Go to slide 2"></button>
      <button class="carousel-dot" aria-label="Go to slide 3"></button>
    </div>

  </section>

  <!-- Highlights strip -->
  <section class="relative z-10 mx-auto -mt-12 max-w-6xl px-4 sm:px-6">
    <div class="grid overflow-hidden shadow-lg sm:grid-cols-3">
      <div class="bg-copper-aged px-8 py-9 text-center">
        <h3 class="font-heading text-lg font-bold text-white">
          Experienced & Professional
        </h3>
        <p class="mt-1 text-sm font-medium text-white/85">
          40 years in the scrap trade
        </p>
      </div>
      <div
        class="bg-cover bg-center px-8 py-9 text-center"
        style="background-image: linear-gradient(rgba(20,18,16,0.78), rgba(20,18,16,0.78)), url('/images/materials/mixed.jpg');"
      >
        <h3 class="font-heading text-lg font-bold text-brass-light">
          Contract-Driven
        </h3>
        <p class="mt-1 text-sm text-white/85">Rates locked for the term</p>
      </div>
      <div
        class="bg-cover bg-center px-8 py-9 text-center"
        style="background-image: linear-gradient(rgba(20,18,16,0.78), rgba(20,18,16,0.78)), url('/images/vehicles/trucks.jpg');"
      >
        <h3 class="font-heading text-lg font-bold text-brass-light">
          Fully Documented
        </h3>
        <p class="mt-1 text-sm text-white/85">
          GST invoices & weighbridge records
        </p>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="bg-surface -mt-24 pt-36 pb-20">
    <div
      class="mx-auto grid max-w-7xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1.7fr]"
    >
      <div data-reveal>
        <h2
          class="font-heading text-3xl font-bold text-steel-charcoal sm:text-4xl"
        >
          About Shahin Scrap
        </h2>
        <div class="mt-3 h-1 w-16 rounded bg-copper-aged"></div>
      </div>
      <div data-reveal>
        <p class="text-justify leading-relaxed text-slate-industrial">
          Shahin Scrap was started in the year 1985 as a scrap dealership in
          Ambikapur. Four decades on, the firm is one of the most recognised
          names in the scrap trade across Surguja district. What began with
          local metal purchases has grown into a contractual B2B operation
          serving mining companies, industrial plants, and road & construction
          contractors — with certified weighment, GST invoicing, and documented
          disposal on every consignment.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/about"
            class="font-heading rounded-sm bg-ink px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-slate-industrial"
            >Learn More</a
          >
          <a
            href="/contact"
            class="font-heading rounded-sm bg-copper-aged px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:brightness-110"
            >Contact Us</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- What we handle -->
  <section id="what-we-do" class="scroll-mt-28">
    <div class="bg-copper-aged py-7">
      <h2
        class="text-center font-heading text-2xl font-extrabold uppercase tracking-wide text-white sm:text-3xl"
      >
        What We Handle
      </h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4">
      {
        handleTiles.map((tile) => (
          <a href={tile.href} class="group relative block">
            <div class="aspect-[4/3] overflow-hidden bg-steel-charcoal">
              <img
                src={tile.image}
                alt={tile.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="bg-copper-aged px-2 py-3 text-center">
              <h3 class="font-heading text-sm font-bold text-white">
                {tile.title}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- How we work -->
  <section class="bg-surface">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20">
      <SectionHeading
        title="How We Work"
        sub="A contract-driven process, not an informal pickup."
      />
      <div class="mt-10">
        <WorkflowDiagram
          steps={['Site Survey', 'Contract & Rates', 'Lift & Process', 'Documentation & Settlement']}
        />
      </div>
    </div>
  </section>

  <!-- Companies marquee -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
    <SectionHeading title="Companies We've Worked With" center />
    <div class="mt-8">
      <ClientMarquee />
    </div>
    <p class="mt-4 text-center">
      <a
        href="/companies"
        class="text-sm font-semibold text-copper-aged hover:text-bronze-warm"
        >See all sectors we serve →</a
      >
    </p>
  </section>

  <!-- Environmental strip -->
  <section class="bg-slate-industrial">
    <div
      class="mx-auto max-w-7xl px-4 sm:px-6 py-10 grid grid-cols-1 sm:grid-cols-3 gap-8"
    >
      <StatBlock light value="20 t" label="CO₂ Avoided Through Recycling" />
      <StatBlock light value="100%" label="Documented Consignments" />
      <StatBlock light value="MSTC" label="Auction & Compliance Ready" />
    </div>
  </section>

  <!-- Featured case study -->
  {
    featured && (
      <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20">
        <SectionHeading
          title="Featured Case Study"
          sub="How a fixed-rate contract turned plant scrap into predictable, documented revenue."
        />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <CaseStudyCard
            title={featured.data.title}
            sector={featured.data.sector}
            scope={featured.data.scope}
            stat={featured.data.stat}
            image={featured.data.image}
            href={`/case-studies/${featured.id}`}
          />
          <div class="flex items-center sm:col-span-1 lg:col-span-2">
            <a
              href="/case-studies"
              class="text-copper-aged font-semibold hover:text-copper-aged"
            >
              View all case studies →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <CTABand />
</BaseLayout>

<script>
  const section = document.getElementById('hero-carousel');
  const track = document.getElementById('hero-track');
  if (section && track) {
    const bgs = [...section.querySelectorAll('.carousel-bg')];
    const dots = [...section.querySelectorAll('.carousel-dot')];
    const count = dots.length;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const goTo = (i: number) => {
      index = (i + count) % count;
      track.style.transform = `translateX(-${index * 100}%)`;
      bgs.forEach((bg, n) => bg.classList.toggle('active', n === index));
      dots.forEach((dot, n) => dot.classList.toggle('active', n === index));
    };
    const stop = () => clearInterval(timer);
    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = setInterval(() => goTo(index + 1), 5000);
    };

    // Hold pauses auto-advance; releasing after a horizontal drag swipes.
    let startX: number | null = null;
    section.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      stop();
    });
    window.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (dx > 50) goTo(index - 1);
      else if (dx < -50) goTo(index + 1);
      start();
    });
    window.addEventListener('pointercancel', () => {
      startX = null;
      start();
    });

    dots.forEach((dot, n) =>
      dot.addEventListener('click', () => {
        goTo(n);
        start();
      })
    );
    start();
  }
</script>
