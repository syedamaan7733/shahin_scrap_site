---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBlock from '../components/StatBlock.astro';
import MaterialCard from '../components/MaterialCard.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import CTAButtons from '../components/CTAButtons.astro';
import CTABand from '../components/CTABand.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { SITE } from '../config/site';
import { getCollection } from 'astro:content';

const featured = (await getCollection('case-studies'))
  .sort((a, b) => a.data.order - b.data.order)
  .find((cs) => cs.data.featured);
---

<BaseLayout title="Metal, Material & Vehicle Scrap — Surguja, Chhattisgarh">
  <!-- Hero -->
  <section
    class="parallax-bg relative min-h-[calc(100vh-4rem)] flex items-center"
    style="background-image: linear-gradient(135deg, rgba(43,38,34,0.92) 0%, rgba(74,52,38,0.85) 50%, rgba(139,101,68,0.7) 100%), url('/images/hero/home.jpg');"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-24 text-canvas">
      <span
        class="inline-block rounded-full border border-brass-light/60 bg-bronze-deep/60 px-4 py-1.5 text-sm font-medium text-gold-pale"
      >
        {SITE.motto}
      </span>
      <h1
        class="mt-6 max-w-3xl font-heading font-bold text-4xl sm:text-5xl lg:text-6xl leading-tight"
      >
        Trusted Since 1985. Built for India's Mines & Industry.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-gold-pale">
        Contractual scrap solutions from Ambikapur, Surguja — metals,
        materials, and end-of-life mining vehicles, handled formally with full
        documentation.
      </p>
      <div class="mt-9">
        <CTAButtons />
      </div>
    </div>
    <a
      href="#what-we-do"
      aria-label="Scroll to what we do"
      class="absolute bottom-6 left-1/2 -translate-x-1/2 text-gold-pale/80 hover:text-canvas animate-bounce"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-8 w-8"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </a>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mx-auto max-w-7xl px-4 sm:px-6 py-20 scroll-mt-16">
    <SectionHeading
      title="What We Do"
      sub="Four lines of work, one standard: certified weighment, GST invoicing, and documentation on every consignment."
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <MaterialCard
        title="Iron & Metal Scrap"
        blurb="Iron & steel, MS/HMS grades and mixed industrial metal scrap — spot purchase or fixed-rate contract, lifted from your site."
        image="/images/materials/iron.jpg"
        href="/services"
      />
      <MaterialCard
        title="Non-Ferrous & Materials"
        blurb="Copper, brass, aluminium, plastic and tyres — graded on certified weighbridges and paid against GST invoice."
        image="/images/materials/copper.jpg"
        href="/services"
      />
      <MaterialCard
        title="Vehicle & Equipment Scrap"
        blurb="End-of-life dozers, Poclain excavators, dumpers, loaders and highway trucks — dismantled and cleared under formal contract."
        image="/images/vehicles/mining.jpg"
        href="/vehicle-scrap"
      />
      <MaterialCard
        title="Contract Site Clearance"
        blurb="Fixed-rate scrap contracts with road, construction and mining companies — rates locked for the contract period."
        image="/images/case-studies/cs-road.jpg"
        href="/services"
      />
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-bronze-deep/10 bg-white">
    <div
      class="mx-auto max-w-7xl px-4 sm:px-6 py-10 grid grid-cols-2 lg:grid-cols-4 gap-8"
    >
      <StatBlock value="Since 1985" label="40 Years in Business" />
      <StatBlock value="Ambikapur" label="Surguja · Chhattisgarh" />
      <StatBlock value="20 t" label="CO₂ Avoided" />
      <StatBlock value="PSU + Pvt" label="Contract-Ready" />
    </div>
  </section>

  <!-- How we work -->
  <section class="bg-gold-pale/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20">
      <SectionHeading
        title="How We Work"
        sub="A contract-driven process, not an informal pickup."
      />
      <div class="mt-10">
        <WorkflowDiagram
          steps={['Site Survey', 'Contract & Rates', 'Lift & Process', 'Documentation & Settlement']}
        />
      </div>
    </div>
  </section>

  <!-- Companies marquee -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-16">
    <SectionHeading title="Companies We've Worked With" center />
    <div class="mt-8">
      <ClientMarquee />
    </div>
    <p class="mt-4 text-center">
      <a
        href="/companies"
        class="text-sm font-semibold text-copper-aged hover:text-amber-signal"
        >See all sectors we serve →</a
      >
    </p>
  </section>

  <!-- Environmental strip -->
  <section class="bg-slate-industrial">
    <div
      class="mx-auto max-w-7xl px-4 sm:px-6 py-10 grid grid-cols-1 sm:grid-cols-3 gap-8"
    >
      <StatBlock light value="20 t" label="CO₂ Avoided Through Recycling" />
      <StatBlock light value="100%" label="Documented Consignments" />
      <StatBlock light value="MSTC" label="Auction & Compliance Ready" />
    </div>
  </section>

  <!-- Featured case study -->
  {
    featured && (
      <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20">
        <SectionHeading
          title="Featured Case Study"
          sub="How a fixed-rate contract turned plant scrap into predictable, documented revenue."
        />
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <CaseStudyCard
            title={featured.data.title}
            sector={featured.data.sector}
            scope={featured.data.scope}
            stat={featured.data.stat}
            image={featured.data.image}
            href={`/case-studies/${featured.id}`}
          />
          <div class="flex items-center sm:col-span-1 lg:col-span-2">
            <a
              href="/case-studies"
              class="text-copper-aged font-semibold hover:text-amber-signal"
            >
              View all case studies →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <CTABand />
</BaseLayout>
